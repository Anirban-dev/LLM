# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/chatapp-db

# JWT Secret Key
JWT_SECRET=chatapp_secret_jwt_key_2026

# Google Gemini API Key (optional, for Speech-to-Text transcription)
GEMINI_API_KEY=

# MinIO / S3 Object Storage Configuration
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=chatapp-media
# Public base URL used for accessing uploaded files in browser/client
S3_PUBLIC_URL=http://127.0.0.1:9000/chatapp-media
